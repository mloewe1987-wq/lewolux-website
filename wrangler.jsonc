{
  // Website lewolux.de: statische Dateien aus ./public (wird von quelle/build.py erzeugt)
  "name": "lewolux",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/downloads/*.exe", "/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "STATS", "class_name": "Stats" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stats"] }],
  "routes": [
    { "pattern": "lewolux.de", "custom_domain": true },
    { "pattern": "www.lewolux.de", "custom_domain": true }
  ]
}
