{
  // Website lewolux.de: statische Dateien aus ./public (wird von quelle/build.py erzeugt)
  "name": "lewolux",
  "main": "worker.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/downloads/*.exe", "/api/*"]
  },
  // Öffentliche Google-Client-ID (kein Geheimnis). Optionales Secret: ADMIN_TOKEN (siehe COMMUNITY-README.md).
  // DEV_FAKE_LOGIN hier NIEMALS eintragen – nur lokal per "wrangler dev --var DEV_FAKE_LOGIN:1".
  "vars": { "GOOGLE_CLIENT_ID": "876811824743-eflhbkjunrda27aqqt0k45r1cv36tsch.apps.googleusercontent.com" },
  "durable_objects": { "bindings": [
    { "name": "STATS", "class_name": "Stats" },
    { "name": "COMMUNITY", "class_name": "Community" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Stats"] },
    { "tag": "v2", "new_sqlite_classes": ["Community"] }
  ],
  "routes": [
    { "pattern": "lewolux.de", "custom_domain": true },
    { "pattern": "www.lewolux.de", "custom_domain": true }
  ]
}
